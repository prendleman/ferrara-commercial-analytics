# Copy to .env. Do not commit .env. A ~/.databrickscfg DEFAULT profile is also read.
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=
# DATABRICKS_WAREHOUSE_ID=your_warehouse_id
# Leave the catalog empty to use the warehouse default catalog.
# DATABRICKS_CATALOG=ferrara_commercial_demo
DATABRICKS_SCHEMA=ferrara_commercial
